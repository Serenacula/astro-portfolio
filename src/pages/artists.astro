---
import Layout from "../layouts/Layout.astro"
import artistData from "../data/artists.json"
import musicianData from "../data/musicians.json"

type Artist = {
    name: string
    link: string
    image: string
    title: string
    extra?: string
}

const artists: Artist[] = artistData
const musicians: Artist[] = musicianData
---

<style>
    h2 {
        text-align: right;
        font-family: vt323;
        font-size: 4rem;

        @media screen and (max-width: 600px) {
            font-size: 3rem;
        }
    }
    .container {
        display: flex;
        flex-direction: row;
        width: 100vw;
        overflow-y: hidden;

        position: relative;

        gap: 64px;
        padding-top: 16px;
        padding-bottom: 16px;

        margin-bottom: 48px;
        margin-left: -48px;
        padding-left: 48px;

        div {
            height: 100%;
            margin-right: 48px;

            a {
                color: black;
                &:hover {
                    color: rgb(150, 38, 255);
                }
                img {
                    width: 300px;
                    height: 500px;
                    object-fit: cover;

                    @media screen and (max-width: 600px) {
                        height: 350px;
                        width: 220px;
                    }
                }
                .title {
                    font-family: vt323;
                    font-size: 2.5rem;
                    line-height: 2.8rem;

                    @media screen and (max-width: 600px) {
                        font-size: 2rem;
                        line-height: 2.2rem;
                    }
                }
            }
            .name {
                font-size: 1.2rem;
                line-height: 1.5rem;
                margin-bottom: 8px;
            }
            .extra {
                font-size: 1rem;
                line-height: 1.3rem;
                text-align: center;
            }
        }
    }

    .line {
        height: 0;
        width: 100%;
        border: 16px solid rgb(151, 42, 42);
        content: "";

        margin-bottom: 32px;
    }
</style>

<Layout>
    <h2>Visual</h2>
    <div class="container">
        {
            artists.map((artist) => (
                <div>
                    <a href={artist.link}>
                        <img
                            src={`/art/webp/${artist.image}.webp`}
                            alt={`${artist.title} by ${artist.name}`}
                        />
                        <p class="title">{artist.title}</p>
                    </a>
                    <p class="name">{artist.name}</p>
                </div>
            ))
        }
    </div>
    <!-- <div class="line"></div> -->
    <h2>Audio</h2>
    <div class="container">
        {
            musicians.map((musician) => (
                <div>
                    <a href={musician.link}>
                        <img
                            src={`/music/webp/${musician.image}.webp`}
                            alt={`${musician.title} by ${musician.name}`}
                        />
                        <p class="title">{musician.title}</p>
                    </a>
                    <p class="name">{musician.name}</p>
                </div>
            ))
        }
    </div>
</Layout>
