---
import Layout from "../layouts/Layout.astro"
import artistData from "../data/artists.json"
import musicianData from "../data/musicians.json"

type Artist = {
    name: string
    link: string
    image: string
    title: string
}

const artists: Artist[] = artistData
const musicians: Artist[] = musicianData
---

<style>
    h2 {
        text-align: right;
        font-family: vt323;
        font-size: 4rem;

        @media screen and (max-width: 600px) {
            font-size: 3rem;
        }
    }
    .container {
        display: flex;
        flex-direction: row;
        width: 100vw;
        overflow-x: scroll;
        overflow-y: hidden;

        position: relative;

        gap: 64px;
        padding-top: 20px;
        padding-bottom: 24px;

        margin-bottom: 48px;
        margin-left: -48px;
        padding-left: 48px;

        border-top: 6px solid black;
        border-bottom: 6px solid black;

        &::-webkit-scrollbar {
            -webkit-appearance: none;
            height: 10px;
        }

        .card {
            min-width: 370px;
            height: 100%;
            margin-right: 48px;
            flex-shrink: 0;

            background: rgb(255, 238, 152);
            border: 4px solid rgb(93, 50, 50);
            padding: 12px;
            box-shadow: 5px 5px 0 black;

            @media screen and (max-width: 600px) {
                min-width: 280px;
            }

            transition:
                transform 0.15s ease,
                box-shadow 0.15s ease;

            &:hover {
                transform: translate(-2px, -2px);
                box-shadow: 7px 7px 0 black;
            }

            a {
                display: block;
                color: black;
                &:hover {
                    color: rgb(150, 38, 255);
                }
                .image-frame {
                    position: relative;
                    width: 100%;
                    height: 500px;
                    overflow: hidden;

                    @media screen and (max-width: 600px) {
                        height: 350px;
                    }

                    img {
                        position: absolute;
                        display: block;
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                    }
                }
                .title {
                    font-family: vt323;
                    font-size: 2.5rem;
                    line-height: 2.8rem;

                    @media screen and (max-width: 600px) {
                        font-size: 2rem;
                        line-height: 2.2rem;
                    }
                }
            }
            .name {
                font-size: 1.2rem;
                line-height: 1.5rem;
                margin-bottom: 8px;
            }
        }
    }
</style>

<Layout>
    <h2>Visual</h2>
    <div class="container">
        {
            artists.map((artist) => (
                <div class="card">
                    <a href={artist.link}>
                        <div class="image-frame">
                            <img
                                src={`/art/webp/${artist.image}.webp`}
                                alt={`${artist.title} by ${artist.name}`}
                            />
                        </div>
                        <p class="title">{artist.title}</p>
                    </a>
                    <p class="name">{artist.name}</p>
                </div>
            ))
        }
    </div>
    <h2>Audio</h2>
    <div class="container">
        {
            musicians.map((musician) => (
                <div class="card">
                    <a href={musician.link}>
                        <div class="image-frame">
                            <img
                                src={`/music/webp/${musician.image}.webp`}
                                alt={`${musician.title} by ${musician.name}`}
                            />
                        </div>
                        <p class="title">{musician.title}</p>
                    </a>
                    <p class="name">{musician.name}</p>
                </div>
            ))
        }
    </div>
</Layout>
