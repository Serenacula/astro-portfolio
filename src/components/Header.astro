---
import { Icon } from "astro-icon/components"
---

<style>
    nav {
        margin-bottom: 64px;
        padding-top: 40px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;

        .main {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            min-width: 0;
            gap: 10px;

            .title {
                display: flex;
                flex-direction: column;

                a {
                    text-decoration: none;
                    color: black;
                    &:hover {
                        color: rgb(150, 38, 255);
                    }
                }
                h1 {
                    font-size: 48px;
                    line-height: 51.5px;
                    font-family: silkscreen, "Courier New", Courier, monospace;
                    font-weight: bolder;
                    margin-left: -6px;

                    max-width: 100%;
                    overflow: visible;
                    padding-bottom: 2px;

                    /* border: solid black 2px; */

                    .word {
                        display: inline-block;
                        white-space: nowrap;
                    }

                    .char {
                        display: inline-flex;
                        justify-content: center;
                        align-items: center;
                        width: 42px;

                        /* border-left: solid black 2px; */
                    }

                    @media (min-width: 936px) {
                        .char {
                            width: 36px;
                        }
                    }

                    @media (min-width: 650px) and (max-width: 936px) {
                        .murray-browne {
                            display: inline-block;
                            white-space: nowrap;
                        }
                    }
                }
                h2 {
                    font-size: 36px;
                    font-family: vt323, "Courier New", Courier, monospace;
                    margin-left: -3px;
                }
            }

            .links {
                margin-left: -3px;
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 0 20px;

                a {
                    font-family: saira;
                    font-size: 1.3rem;
                }
            }
        }

        .socials {
            padding-top: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px 0;
            flex-shrink: 0;

            svg {
                display: block;
                font-size: 24px;
            }

            .dot {
                width: 4px;
                height: 4px;
                background: rgb(61, 61, 61);
                flex-shrink: 0;
            }
        }

        .linkColors > * {
            color: rgb(61, 61, 61);

            &:hover {
                color: rgb(150, 38, 255);
            }
        }
    }
</style>

<header>
    <nav>
        <div class="main">
            <div class="title">
                <h1>
                    <a href="/">
                        <span class="word"
                            ><span class="char">F</span><span class="char"
                                >a</span
                            ><span class="char">y</span><span class="char"
                                >l</span
                            ><span class="char">e</span><span class="char"
                                >e</span
                            ></span
                        >
                        <span class="murray-browne">
                            <span class="word"
                                ><span class="char">M</span><span class="char"
                                    >u</span
                                ><span class="char">r</span><span class="char"
                                    >r</span
                                ><span class="char">a</span><span class="char"
                                    >y</span
                                ></span
                            >
                            <span class="word"
                                ><span class="char">B</span><span class="char"
                                    >r</span
                                ><span class="char">o</span><span class="char"
                                    >w</span
                                ><span class="char">n</span><span class="char"
                                    >e</span
                                ></span
                            >
                        </span>
                    </a>
                </h1>
                <h2>
                    <span>Fullstack Developer</span>
                </h2>
            </div>

            <div class="links linkColors">
                <a href="/">portfolio</a>
                <span class="dot" aria-hidden="true"></span>
                <a href="/artists">cool artists I know of</a>
            </div>
        </div>

        <span class="socials linkColors">
            <a href="https://github.com/Serenacula" aria-label="Github">
                <Icon name="mdi:github" />
            </a>
            <span class="dot" aria-hidden="true"></span>
            <span
                class="emailObscural"
                data-giveName="faylee doht murraybrowne"
                aria-label="Email"
            >
                <Icon name="mdi:email" />
            </span>
            <span class="dot" aria-hidden="true"></span>
            <a
                href="https://www.linkedin.com/in/faylee-murray-browne-47ba70242/"
                aria-label="LinkedIn"
            >
                <Icon name="mdi:linkedin" />
            </a>
        </span>
    </nav>
</header>

<script>
    import "../scripts/obscureEmail.js"
</script>
