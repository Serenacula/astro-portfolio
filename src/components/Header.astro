---
import { Icon } from "astro-icon/components"
---

<style>
    nav {
        margin-bottom: 64px;
        padding-top: 40px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;

        .main {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            min-width: 0;
            gap: 10px;

            .title {
                display: flex;
                flex-direction: column;

                a {
                    text-decoration: none;
                    color: black;
                    &:hover {
                        color: rgb(150, 38, 255);
                    }
                }
                h1 {
                    font-size: 48px;
                    font-family: silkscreen, "Courier New", Courier, monospace;
                    margin-left: -6px;

                    max-width: 100%;
                    overflow: auto;
                    white-space: wrap;
                }
                h2 {
                    font-size: 36px;
                    font-family: vt323, "Courier New", Courier, monospace;
                    margin-left: -3px;
                }
            }

            .links {
                margin-left: -3px;
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 0 20px;

                a {
                    font-family: saira;
                    font-size: 1.3rem;
                }
            }
        }

        .socials {
            padding-top: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px 0;
            flex-shrink: 0;

            svg {
                display: block;
                font-size: 24px;
            }

            .dot {
                width: 4px;
                height: 4px;
                background: rgb(61, 61, 61);
                flex-shrink: 0;
            }
        }

        .linkColors > * {
            color: rgb(61, 61, 61);

            &:hover {
                color: rgb(150, 38, 255);
            }
        }
    }
</style>

<header>
    <nav>
        <div class="main">
            <div class="title">
                <h1>
                    <a href="/">Faylee Murray Browne</a>
                </h1>
                <h2>
                    <span>Fullstack Developer</span>
                </h2>
            </div>

            <div class="links linkColors">
                <a href="/">portfolio</a>
                <span class="dot" aria-hidden="true"></span>
                <a href="/artists">cool artists I know of</a>
            </div>
        </div>

        <span class="socials linkColors">
            <a href="https://github.com/Serenacula" aria-label="Github">
                <Icon name="mdi:github" />
            </a>
            <span class="dot" aria-hidden="true"></span>
            <span
                class="emailObscural"
                data-giveName="faylee doht murraybrowne"
                aria-label="Email"
            >
                <Icon name="mdi:email" />
            </span>
            <span class="dot" aria-hidden="true"></span>
            <a
                href="https://www.linkedin.com/in/faylee-murray-browne-47ba70242/"
                aria-label="LinkedIn"
            >
                <Icon name="mdi:linkedin" />
            </a>
        </span>
    </nav>
</header>

<script>
    import "../scripts/obscureEmail.js"
</script>
